# Team spaces (independent git repos, never track in root scaffold)
[0-9]-*/

# Composed context files (generated at runtime)
CLAUDE.md
SCAFFOLDING.md

# Private layers (never tracked)
*.local.md

# State and secrets
.datacore/state/
.datacore/env/

# Module data (per-space, private)
.datacore/modules/*/data/

# Obsidian / PKM
.obsidian/
.trash/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
